<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"

    android:background="@drawable/bg_main">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:fontFamily="@font/styletext1"
        style="@style/Widget.App.Button"
        android:background="@drawable/fontoolbar"
        app:title=""
        app:titleTextColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />
    <android.widget.Button
        android:id="@+id/butt1"
        android:layout_width="350dp"
        android:layout_height="90dp"
        android:text="Начать прогулку"
        android:fontFamily="@font/styletext1"
        android:textSize="28sp"
        style="@style/Widget.App.Button"
        android:background="@drawable/buttononthefon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.50"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.25"
    />

    <View
        android:id="@+id/line_start"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/label_text"
        app:layout_constraintEnd_toStartOf="@+id/label_text"
        app:layout_constraintStart_toStartOf="@+id/button_container"
        app:layout_constraintTop_toTopOf="@+id/label_text"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/styletext1"
        android:text="Связаться с нами"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/button_container"
        app:layout_constraintEnd_toStartOf="@+id/line_end"
        app:layout_constraintStart_toEndOf="@+id/line_start" />

    <View
        android:id="@+id/line_end"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/label_text"
        app:layout_constraintEnd_toEndOf="@+id/button_container"
        app:layout_constraintStart_toEndOf="@+id/label_text"
        app:layout_constraintTop_toTopOf="@+id/label_text"
        android:layout_marginStart="16dp" />

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.99">

        <ImageButton
            android:id="@+id/btnVK"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/vk_icon"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="VK" />

        <ImageButton
            android:id="@+id/btnEmail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/email_ico"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Email" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>


