<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomButtons">

        <WebView
            android:id="@+id/mapWebView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.4" />  <!-- 40% экрана -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/landList"
            android:fontFamily="@font/styletext1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />  <!-- 60% экрана список -->

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/white"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">


        <android.widget.Button
            android:id="@+id/btnPlans"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:layout_margin="4dp"
            android:fontFamily="@font/styletext1"
            style="@style/Widget.App.Button"
            android:background="@drawable/buttononthefon"
            android:text="мои планы" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>