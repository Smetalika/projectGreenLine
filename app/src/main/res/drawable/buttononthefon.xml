<?xml version="1.0" encoding="utf-8"?>
<ripple  xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@android:color/darker_gray"> <!-- Цвет волны при нажатии -->
    <item>
        <shape android:shape="rectangle">
            <!-- Скругление углов -->
            <corners android:radius="15dp" />
            <!-- Цвет фона -->
            <solid android:color="#3A6B3B" />
            <!-- Отступы текста от краев (padding) -->
            <padding
                android:bottom="12dp"
                android:left="24dp"
                android:right="24dp"
                android:top="12dp" />
        </shape>
    </item>
</ripple >